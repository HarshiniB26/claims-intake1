# Copy to .env and populate. .env is ignored and must never enter a commit.

# Anthropic. Issued to you at the start of the week.
ANTHROPIC_API_KEY=

# Azure OpenAI. The endpoint and key come from your Azure OpenAI resource.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# The name you gave your deployment when you created it. This is your choice and
# it is not the model's name, which is why it lives here rather than in config.py.
AZURE_OPENAI_DEPLOYMENT=

# Pinned for the cohort and supplied to you already filled in. Everyone runs the
# same API version so that Day 5 comparisons are comparable across the room. Do
# not substitute another value.
AZURE_OPENAI_API_VERSION=[PENDING: Coforge - Azure OpenAI API version string, needed by Day 2]
